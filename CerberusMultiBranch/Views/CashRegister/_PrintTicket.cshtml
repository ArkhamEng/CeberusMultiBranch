@model CerberusMultiBranch.Models.Entities.Operative.Sale
@using CerberusMultiBranch.Support;
@using CerberusMultiBranch.Models.Entities.Operative

<script src="~/Scripts/printThis.js"></script>


<div hidden>
    <div id="divTicket" style="width:270px;">
        <table class="Ticket" style="width:100%;">
            <tr>
                <td align="center" colspan="2" style="padding-top: 10px">
                    <div style="width:200px">
                        <img src="@Url.Content(Model.Branch.LogoPath)" class="img-responsive" />
                    </div>
                </td>
            </tr>

            <tr style="padding-top: 10px">
                <td align="center" colspan="2">
                    Sucursal @Model.Branch.Name
                </td>
            </tr>
            <tr>
                <td align="center" colspan="2">
                    @Model.Branch.Address
                </td>
            </tr>
            <tr>
                <td style="height:20px" colspan="2"></td>
            </tr>
            <tr style="padding-top: 10px">
                <td class="text-left">
                    <label>Folio</label><br />
                </td>
                <td class="text-right">
                    @Model.Folio.ToUpper()
                </td>
            </tr>
            <tr style="padding-top: 10px">
                <td class="text-left">
                    <label>
                        Agente
                    </label>
                </td>
                <td class="text-right">
                    @Model.User.UserName.ToUpper()
                </td>
            </tr>
            <tr style="padding-top: 10px">
                <td class="text-left">
                    <label>Fecha</label><br />
                </td>
                <td class="text-right">
                    @Model.TransactionDate.ToString("dd/MM/yyyy HH:mm")
                </td>
            </tr>
            <tr style="padding-top: 10px">
                <td class="text-left">
                    <label>Venta</label><br />
                </td>
                <td class="text-right">
                    @Model.TransactionType.GetName()
                </td>
            </tr>

            @if (Model.Status == TranStatus.Revision)
            {
                <tr style="padding-top: 10px">
                    <td class="text-left">
                        <label>Expira</label><br />
                    </td>
                    <td class="text-right">
                        @Model.Expiration.ToString("dd/MM/yyyy")
                    </td>
                </tr>
                var debt = (Model.TotalTaxedAmount - Model.SalePayments.Sum(s => s.Amount));
                <tr style="padding-top: 10px">
                    <td class="text-left">
                        <label> Total Pagos</label>
                    </td>
                    <td class="text-right">
                        @Model.SalePayments.Sum(s => s.Amount).ToMoney()
                    </td>
                </tr>
                <tr style="padding-top: 10px">
                    <td class="text-left">
                        <label> Restante</label>
                    </td>
                    <td class="text-right">
                        @debt.ToMoney()
                    </td>
                </tr>
            }

            else if (Model.SalePayments.Count > Cons.One)
            {
                <tr style="padding-top: 10px">
                    <td class="text-left">
                        <label>Pago</label>
                    </td>
                    <td class="text-right">
                        <a>@PaymentMethod.Mixto.ToString()</a>
                    </td>
                </tr>
            }
            else
            {
                <tr style="padding-top: 10px">
                    <td class="text-left">
                        <label>Pago</label>
                    </td>
                    <td class="text-right">
                        @Model.SalePayments.First().PaymentMethod.ToString()
                    </td>
                </tr>
            }
            <tr>
                <td style="height:30px" colspan="2"></td>
            </tr>
            <tr style="padding-top: 10px">
                <td align="center" colspan="2">
                    <table style="width: 100%; min-height:550px;">
                        <tr style="height:20px;">
                            <td class="text-left">
                                Part.
                            </td>
                            <td class="text-center">
                                Desc.
                            </td>
                            <td class="text-center">
                                Cant.
                            </td>
                            <td class="text-center">
                                Tot.
                            </td>
                        </tr>


                        @{ int part = 1;}
                        @foreach (var tI in Model.SaleDetails)
                        {
                            var i = tI.Product.Code.Length - 4;
                            var sCode = tI.Product.Code; //.Length <= 4 ? tI.Product.Code : tI.Product.Code.Substring(i, 4);
                            var sName = tI.Product.Name.Length <= 12 ? tI.Product.Name : tI.Product.Name.Substring(0, 12);
                            <tr style="height:40px;">
                                <td>@part</td>
                                <td class="text-left">
                                    @if (tI.ParentId == null)
                                    {
                                        @sCode<br />
                                    }
                                    else
                                    {
                                        sName = (sCode + " " + sName).ToString();
                                    }
                                    @sName
                                </td>

                                <td class="text-center">
                                    @tI.DueQuantity
                                </td>
                                <td class="text-right">
                                    @if (tI.ParentId == null)
                                    {
                                        @tI.TaxedAmount.ToMoney()
                                    }
                                </td>
                            </tr>
                            part++;
                        }

                        <tr>
                            <td />
                            <td />
                            <td />
                            <td />
                        </tr>


                        <tr style="height:40px;">
                            <td class="text-right" colspan="3">
                                <label>Total de productos</label>
                            </td>
                            <td class="text-center">@Model.SaleDetails.Sum(x => x.Quantity)</td>
                        </tr>

                        <tr style="height: 40px;">
                            <td colspan="2" />
                            <td>
                                <label>
                                    Total
                                </label>
                            </td>
                            <td align="right">
                                @Model.TotalTaxedAmount.ToMoney()
                            </td>
                        </tr>

                        <tr style="height:60px;">
                            <td colspan="4" align="center">
                                NO VALIDO COMO COMPROBANTE FISCAL
                            </td>
                        </tr>
                        <tr style="height:150px;">
                            <td colspan="4">
                                <label>
                                    Estimado cliente,
                                    Solo se acepta mercancía en
                                    devolución   si  cumple con
                                    las  siguientes  políticas:
                                </label>
                                <br />
                                1. Mercancía sin daño
                                o retrabajo<br />
                                2. Mercancía   con
                                empaque original<br />
                                3. Máximo treinta días a
                                la fecha de la nota<br />

                            </td>
                        </tr>
                        <tr style="height:150px; border-bottom:solid; border-bottom-width: 1px;">
                            <td colspan="4" align="center" style="margin-top:1px;">
                                <label>
                                    Solicita tu factura por WhatsApp
                                    durante el mes en curso.
                                </label><br />
                                <label>
                                    * No hay cancelación en preventas.
                                </label><br />
                                ====  GRACIAS POR SU COMPRA  ====
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#divTicket").printThis();
    });

    function PrintNote() {
        $("#divTicket").printThis();
    }
</script>